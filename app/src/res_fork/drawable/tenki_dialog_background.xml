<?xml version="1.0" encoding="utf-8"?>
<!--
  shiroikuma fork: the ground for the View-world dialogs (icon-pack previews, widget config), which
  MaterialAlertDialogBuilder builds and the Compose theme therefore never touches. Black, with the
  house yellow border, so they read like every Compose dialog in the app.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#000000" />
    <stroke
        android:width="1dp"
        android:color="#FFFF00" />
    <corners android:radius="12dp" />
</shape>
